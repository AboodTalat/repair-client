# ─────────────────────────────────────────────────────────────────────────────
# repair/ — Next.js frontend environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.
#
# In production, set these as Vercel project environment variables:
#   Project Settings → Environment Variables → Production / Preview / Development
# ─────────────────────────────────────────────────────────────────────────────


# ── GraphQL endpoint ──────────────────────────────────────────────────────────
#
# URL of the repair GraphQL sub-server.
# NEXT_PUBLIC_ prefix means this value is baked into the client JS bundle —
# it is NOT secret.  Point it at your backend origin.
#
# Local dev (default if unset): requests go to /repair/graphql via Next.js
# proxy or the Express server running on the same port (localhost:3000).
#
# Staging / production: set this to your deployed backend URL, e.g.:
#   https://api.example.com/repair/graphql
#
NEXT_PUBLIC_REPAIR_GRAPHQL_URL=http://localhost:3000/repair/graphql


# ── localStorage encryption key ───────────────────────────────────────────────
#
# AES key used to encrypt the Zustand store snapshot in localStorage.
# NEXT_PUBLIC_ means this ships in the JS bundle — it is obfuscation, not
# real secrecy.  Real security is server-side refresh-token rotation.
# Change this key per environment so different envs can't read each other's
# localStorage (e.g. dev can't decrypt a prod snapshot).
#
# Use any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
NEXT_PUBLIC_STORAGE_SECRET_KEY=change-me-use-a-long-random-string-here
